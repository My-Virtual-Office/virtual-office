# ─────────────────────────────────────────────────────────────────────────────
# Virtual Office — Docker Compose environment TEMPLATE.
#
#   cp .env.example .env      # then replace every placeholder below
#
# NEVER commit the real .env (it is gitignored). Keep only this template in git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared auth secrets ──────────────────────────────────────────────────────
# JWT_SECRET is shared by gateway-api + user-service (and the SkyOffice server);
# use >= 32 bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-me-with-a-strong-random-jwt-secret
# Server-to-server token (workspace/room/chat + SkyOffice); any strong random string.
INTERNAL_API_TOKEN=replace-me-with-a-strong-random-token

# ── Datastore credentials ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=virtual_office

POSTGRES_DB=workspace
POSTGRES_USER=workspace
POSTGRES_PASSWORD=changeme

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=changeme

# ── Agora (voice) — room-service token minting + SkyOffice client SDK ─────────
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# ── Host-facing URLs baked into the frontends at BUILD time ──────────────────
# The browser runs on the host, so these must be host-reachable (localhost:PORT).
# On a LAN, set the host IP instead of localhost, then rebuild the frontends.
PUBLIC_GATEWAY_URL=http://localhost:8080
PUBLIC_COLYSEUS_WS=ws://localhost:2567
PUBLIC_ROOM_WS=ws://localhost:8086

# ── Gateway CORS ─────────────────────────────────────────────────────────────
# "*" is an allowed-origin PATTERN (reflects the request origin, works on a LAN).
# Lock this down to real origins for production.
GATEWAY_CORS_ORIGINS=*

# ── Grafana admin (optional; defaults to admin/admin if unset) ───────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# ── AI assistant (ai-service) ────────────────────────────────────────────────
# Server-side only — never expose this key to the browser. Leave blank to
# disable the assistant (the service stays up and returns 503 for /api/ai/chat).
#
# The OpenAI API is pay-as-you-go and is NOT included with a ChatGPT Plus
# subscription. The assistant only needs chat-completions + function calling, so
# any OpenAI-COMPATIBLE provider works — several have free tiers. Set the base
# URL + a key + a model from that provider and leave the rest alone.
#
#   OpenAI  (paid)   BASE_URL unset                                           MODEL=gpt-4o-mini
#   Groq    (free)   https://api.groq.com/openai/v1                           MODEL=llama-3.3-70b-versatile
#   Gemini  (free)   https://generativelanguage.googleapis.com/v1beta/openai/ MODEL=gemini-2.0-flash
#   OpenRtr (free)   https://openrouter.ai/api/v1                             MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Ollama  (local)  http://host.docker.internal:11434/v1                     MODEL=llama3.1  (key can be any string)
#
# Free tiers and model names change — check the provider's current docs.
# Whatever you pick MUST support tool/function calling or the assistant can only chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ── Demo data seeder (profile "seed"; run: docker compose --profile seed up seed)
# Password given to every seeded Northstar account. SEED_FORCE=1 re-creates
# tasks/messages even if the workspace was already seeded.
SEED_PASSWORD=Northstar@2026
SEED_FORCE=0
