{
  "uid": "vo-logs",
  "title": "Virtual Office — Logs & Errors",
  "tags": ["virtual-office", "loki"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "service", "stream": "{project=\"virtual-office\"}", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (selected range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum(count_over_time({project=\"virtual-office\", service=~\"$service\"} |~ \"(?i)\\\\b(error|exception|fatal)\\\\b\" [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (selected range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum(count_over_time({project=\"virtual-office\", service=~\"$service\"} |~ \"(?i)\\\\bwarn\" [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Services reporting",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "count(count by (service) (count_over_time({project=\"virtual-office\"} [$__range])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Log lines/sec",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum(rate({project=\"virtual-office\", service=~\"$service\"} [5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors by service",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (count_over_time({project=\"virtual-office\", service=~\"$service\"} |~ \"(?i)\\\\b(error|exception|fatal)\\\\b\" [$__interval]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 12, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{service}}",
          "expr": "sum by (service) (rate({project=\"virtual-office\", service=~\"$service\"} [$__interval]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Errors & exceptions — newest first",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{project=\"virtual-office\", service=~\"$service\"} |~ \"(?i)\\\\b(error|exception|fatal)\\\\b\""
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "All logs — filtered by $search",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{project=\"virtual-office\", service=~\"$service\"} |= \"$search\""
        }
      ]
    }
  ]
}
